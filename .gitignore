# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds NAMES and never values. Without this
# negation `.env*` silently swallows it, and the one file that documents which
# variables the app needs can never be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite data
/data/

# Agent worktrees. Isolated checkouts a subagent works in, created and removed
# by the harness — a full copy of this repo, inside this repo. Ignored rather
# than committed. Scoped to the subdirectory so project-level Claude settings
# can still be tracked if they are ever added.
.claude/worktrees/
