# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# LLM provider — server-side only. Never rename these with NEXT_PUBLIC_.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# How hard the model is asked to think. Reading a receipt is extraction, not
# deduction — the figure is printed on the image — so "none" is the default and
# the cheapest: thinking costs output tokens and buys nothing here. Raise it
# only if a real misread justifies the spend. An unrecognised value falls back
# to "none" rather than failing the request.
# OPENAI_REASONING_EFFORT=none   # none | low | medium | high

# Optional when OPENAI_MODEL is changed to a model whose pricing Max does not
# know. Used only for the per-call server log; these do not set provider spend.
# OPENAI_INPUT_USD_PER_MILLION_TOKENS=0.20
# OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=1.20
